# Names only — never put real values in this file.
# Local files: .env.local (Neon branch dev), .env.test (branch test), .env.prod.local (branch production).
# Scripts can target another file with ENV_FILE, set in the shell: ENV_FILE=.env.prod.local npm run db:migrate

# Neon pooled connection — app runtime, seed, metrics, tests (Vercel: yes)
DATABASE_URL=
# Neon direct (non-pooled) connection — drizzle-kit migrations only (Vercel: no)
DATABASE_URL_UNPOOLED=

# Better Auth signing secret, at least 32 random characters, different per environment (Vercel: yes)
BETTER_AUTH_SECRET=
# Public base URL, no trailing slash; https in production (Vercel: yes)
BETTER_AUTH_URL=

# Gmail address that sends verification emails (Vercel: yes; leave empty in dev to log links)
SMTP_USER=
# Gmail app password for SMTP_USER (Vercel: yes)
SMTP_PASSWORD=

# Password for every fictional seeded user — npm run db:seed only (Vercel: no)
SEED_PASSWORD=
